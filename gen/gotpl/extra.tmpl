{{- define "errors" -}}
// Error is the type of the constant errors of this package.
type Error string

// Error values.
const (
	// ErrInvalidContext is the invalid context error.
	ErrInvalidContext Error = "invalid context"

	// ErrMsgMissingParamsOrResult is the error for a message that has neither
	// params nor a result.
	ErrMsgMissingParamsOrResult Error = "msg missing params or result"
)

// Error satisfies the error interface.
func (err Error) Error() string {
	return string(err)
}

// ErrUnknownCommandOrEvent is an unknown command or event error.
type ErrUnknownCommandOrEvent string

// Error satisfies the error interface.
func (err ErrUnknownCommandOrEvent) Error() string {
	return fmt.Sprintf("unknown command or event %q", string(err))
}
{{end -}}

{{- define "methodtype" -}}
// Domain returns the Chrome DevTools Protocol domain of the event or command.
func (t MethodType) Domain() string {
	return string(t[:strings.IndexByte(string(t), '.')])
}

// MethodType values.
const (
{{- range .}}{{$d := .}}
{{- range .Commands}}
	{{commandMethodType . $d}} = {{packageName $d}}.{{commandMethodType . nil}}
{{- end}}
{{- range .Events}}
	{{eventMethodType . $d}} = {{printf "%q" (protoName . $d)}}
{{- end}}
{{- end}}
)
{{end -}}

{{- define "message" -}}
type empty struct{}

var emptyVal = &empty{}

// UnmarshalMessage unmarshals the message result or params.
func UnmarshalMessage(msg *Message, opts ...jsonv2.Options) (any, error) {
	var v any
	switch msg.Method {
{{- range .}}{{$d := .}}
{{- range .Commands}}
	case {{commandMethodType . $d}}:
{{- if not .Returns}}
		return emptyVal, nil
{{- else}}
		v = new({{packageName $d}}.{{commandReturnsType .}})
{{- end}}
{{- end}}
{{- range .Events}}
	case {{eventMethodType . $d}}:
		v = new({{packageName $d}}.{{eventType .}})
{{- end}}
{{- end}}
	default:
		return nil, cdp.ErrUnknownCommandOrEvent(msg.Method)
	}

	var buf jsontext.Value
	switch {
	case msg.Params != nil:
		buf = msg.Params
	case msg.Result != nil:
		buf = msg.Result
	default:
		return nil, cdp.ErrMsgMissingParamsOrResult
	}
	if err := jsonv2.Unmarshal(buf, v, opts...); err != nil {
		return nil, err
	}
	return v, nil
}
{{end -}}

