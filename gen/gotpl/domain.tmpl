{{- define "domain" -}}
{{- $d := .Domain -}}
{{- range .Domain.Commands}}
{{template "command" (command . $d $.Domains)}}
{{end -}}
{{- range .Domain.Events}}
{{template "eventvalue" (command . $d $.Domains)}}
{{end -}}
{{if .Domain.Commands}}
// Command names.
const (
{{- range .Domain.Commands}}
	{{commandMethodType . nil}} = {{printf "%q" (protoName . $d)}}
{{- end}}
)
{{end -}}
{{end -}}

{{- define "command" -}}
{{- if .C.Parameters}}
{{template "type" (typeData (paramsType .C) commandTypePrefix commandTypeSuffix .D .Domains false true)}}

{{end -}}
{{- if .C.Returns}}
{{template "type" (typeData (returnsType .C) commandReturnsPrefix commandReturnsSuffix .D .Domains false false)}}

{{end -}}
{{template "commandvalue" .}}
{{end -}}

{{- define "commandvalue" -}}
{{- $name := camelName .C -}}
{{comment .C.Description (printf "%s " $name)}}
//
// See: {{docRefLink .C}}
var {{$name}} = cdp.Command[{{if .C.Parameters}}{{commandType .C}}{{else}}cdp.Empty{{end}}, {{if .C.Returns}}{{commandReturnsType .C}}{{else}}cdp.Empty{{end}}]{Method: {{commandMethodType .C nil}}}
{{end -}}

{{- define "eventvalue" -}}
{{- $name := camelName .C -}}
{{comment .C.Description (printf "%s " $name)}}
//
// See: {{docRefLink .C}}
var {{$name}} = cdp.Event[{{eventType .C}}]{Method: {{printf "%q" (protoName .C .D)}}}
{{end -}}
