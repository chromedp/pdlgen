// Code generated by pdlgen. DO NOT EDIT.

package jsonv2_test

import (
	"errors"
	"strings"
	"testing"

	"github.com/chromedp/cdproto/cdp/jsonv2"
)

// This test has no build constraint. It runs with the standard packages and,
// with the tag cdproto_jsoncompat, with the module that json_compat.go uses.
// Both runs must pass with the same expected values.

// options are the options that the chromedp module uses for every message.
var options = jsonv2.JoinOptions(jsonv2.DefaultOptionsV2(), jsonv2.AllowInvalidUTF8(true))

// sample is a struct with the tags that the generated types use.
type sample struct {
	Name   string   `json:"name"`
	Count  int64    `json:"count,omitempty,omitzero"`
	Flag   bool     `json:"flag"`
	Tags   []string `json:"tags,omitempty,omitzero"`
	Inner  *sample  `json:"inner,omitempty,omitzero"`
	Raw    jsonv2.Value `json:"raw,omitempty,omitzero"`
	Data   []byte   `json:"data,omitempty,omitzero"`
	Ratio  *float64 `json:"ratio,omitempty,omitzero"`
	NoTags []string `json:"noTags"`
	Extra  map[string]any `json:"extra"`
}

func TestMarshal(t *testing.T) {
	zero := 0.0
	tests := []struct {
		name string
		in   any
		exp  string
	}{
		{"zero", sample{}, `{"name":"","flag":false,"noTags":[],"extra":{}}`},
		{"omitted", sample{Name: "a", Count: 2, Tags: []string{"x"}}, `{"name":"a","count":2,"flag":false,"tags":["x"],"noTags":[],"extra":{}}`},
		{"nested", sample{Inner: &sample{Name: "b"}}, `{"name":"","flag":false,"inner":{"name":"b","flag":false,"noTags":[],"extra":{}},"noTags":[],"extra":{}}`},
		{"raw", sample{Raw: jsonv2.Value(` {"k": [1, 2]} `)}, `{"name":"","flag":false,"raw":{"k":[1,2]},"noTags":[],"extra":{}}`},
		{"bytes", sample{Data: []byte("hello")}, `{"name":"","flag":false,"data":"aGVsbG8=","noTags":[],"extra":{}}`},
		{"zero pointer", sample{Ratio: &zero}, `{"name":"","flag":false,"ratio":0,"noTags":[],"extra":{}}`},
		{"map", map[string]int{"a": 1}, `{"a":1}`},
		{"nil slice", []int(nil), `[]`},
		{"html", "<a&b>", `"<a&b>"`},
		{"invalid utf8", "a\xffb", `"a�b"`},
		{"any", []any{1, "b", nil, true, 1.5}, `[1,"b",null,true,1.5]`},
	}
	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			b, err := jsonv2.Marshal(test.in, options)
			if err != nil {
				t.Fatalf("expected no error, got: %v", err)
			}
			if got := string(b); got != test.exp {
				t.Errorf("expected %s, got: %s", test.exp, got)
			}
		})
	}
}

func TestUnmarshal(t *testing.T) {
	tests := []struct {
		name string
		in   string
		exp  sample
	}{
		{"empty", `{}`, sample{}},
		{"fields", `{"name":"a","count":3,"flag":true,"tags":["x","y"]}`, sample{Name: "a", Count: 3, Flag: true, Tags: []string{"x", "y"}}},
		{"unknown member", `{"name":"a","unknown":{"deep":[1,2,3]}}`, sample{Name: "a"}},
		{"names are case sensitive", `{"NAME":"a","Count":3}`, sample{}},
		{"null", `{"name":null,"tags":null}`, sample{}},
		{"nested", `{"inner":{"name":"b"}}`, sample{Inner: &sample{Name: "b"}}},
		{"raw", `{"raw": {"k": [1, 2]}}`, sample{Raw: jsonv2.Value(`{"k": [1, 2]}`)}},
		{"bytes", `{"data":"aGVsbG8="}`, sample{Data: []byte("hello")}},
		{"invalid utf8", "{\"name\":\"a\xffb\"}", sample{Name: "a�b"}},
	}
	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			var got sample
			if err := jsonv2.Unmarshal([]byte(test.in), &got, options); err != nil {
				t.Fatalf("expected no error, got: %v", err)
			}
			if !equal(got, test.exp) {
				t.Errorf("expected %+v, got: %+v", test.exp, got)
			}
		})
	}
}

func TestUnmarshalAny(t *testing.T) {
	tests := []struct {
		name string
		in   string
		exp  any
	}{
		{"number", `1`, float64(1)},
		{"text", `"a"`, "a"},
		{"null", `null`, nil},
		{"array", `[1,"a",null]`, []any{float64(1), "a", nil}},
		{"object", `{"a":[true]}`, map[string]any{"a": []any{true}}},
	}
	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			var got any
			if err := jsonv2.Unmarshal([]byte(test.in), &got, options); err != nil {
				t.Fatalf("expected no error, got: %v", err)
			}
			if a, b := mustMarshal(t, got), mustMarshal(t, test.exp); a != b {
				t.Errorf("expected %s, got: %s", b, a)
			}
		})
	}
}

func TestUnmarshalErrors(t *testing.T) {
	tests := []struct {
		name   string
		in     string
		out    any
		syntax bool
	}{
		{"truncated", `{"name":`, new(sample), true},
		{"trailing data", `{} {}`, new(sample), true},
		{"not json", `name`, new(sample), true},
		{"duplicate name", `{"name":"a","name":"b"}`, new(sample), true},
		{"wrong type", `{"name":5}`, new(sample), false},
		{"wrong shape", `[1]`, new(sample), false},
		{"number overflow", `{"count":1e100}`, new(sample), false},
		{"bad base64", `{"data":"%%"}`, new(sample), false},
	}
	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			err := jsonv2.Unmarshal([]byte(test.in), test.out, options)
			if err == nil {
				t.Fatalf("expected an error")
			}
			var syntax *jsonv2.SyntacticError
			if got := errors.As(err, &syntax); got != test.syntax {
				t.Errorf("expected a syntactic error to be %t, got: %t (%v)", test.syntax, got, err)
			}
		})
	}
}

func TestValue(t *testing.T) {
	tests := []struct {
		in   string
		kind byte
	}{
		{`null`, 'n'},
		{`true`, 't'},
		{`false`, 'f'},
		{`"a"`, '"'},
		{`1.5`, '0'},
		{`{}`, '{'},
		{`[]`, '['},
	}
	for _, test := range tests {
		t.Run(test.in, func(t *testing.T) {
			var v jsonv2.Value
			if err := jsonv2.Unmarshal([]byte(test.in), &v, options); err != nil {
				t.Fatalf("expected no error, got: %v", err)
			}
			if got := string(v); got != test.in {
				t.Errorf("expected %s, got: %s", test.in, got)
			}
			if got := v.Kind(); byte(got) != test.kind {
				t.Errorf("expected kind %q, got: %q", test.kind, got)
			}
		})
	}
}

func TestStream(t *testing.T) {
	var dec jsonv2.Decoder
	dec.Reset(strings.NewReader(`{"name":"a"} {"name":"b"}` + "\n" + `{"name":`))
	var names []string
	var last error
	for {
		var s sample
		if last = jsonv2.UnmarshalDecode(&dec, &s, options); last != nil {
			break
		}
		names = append(names, s.Name)
	}
	if got := strings.Join(names, ","); got != "a,b" {
		t.Errorf("expected a,b, got: %s", got)
	}
	if last == nil {
		t.Fatalf("expected an error")
	}
	var syntax *jsonv2.SyntacticError
	if !errors.As(last, &syntax) {
		t.Errorf("expected a syntactic error, got: %v", last)
	}

	var out strings.Builder
	var enc jsonv2.Encoder
	enc.Reset(&out)
	for _, name := range []string{"a", "b"} {
		if err := jsonv2.MarshalEncode(&enc, sample{Name: name}, options); err != nil {
			t.Fatalf("expected no error, got: %v", err)
		}
	}
	const exp = `{"name":"a","flag":false,"noTags":[],"extra":{}}` + "\n" +
		`{"name":"b","flag":false,"noTags":[],"extra":{}}` + "\n"
	if got := out.String(); got != exp {
		t.Errorf("expected %q, got: %q", exp, got)
	}
}

func TestJoinOptions(t *testing.T) {
	const in = "a\xffb"
	if _, err := jsonv2.Marshal(in, jsonv2.DefaultOptionsV2()); err == nil {
		t.Errorf("expected an error for text that is not valid UTF-8")
	}
	if _, err := jsonv2.Marshal(in, jsonv2.JoinOptions(jsonv2.DefaultOptionsV2(), jsonv2.AllowInvalidUTF8(true))); err != nil {
		t.Errorf("expected no error, got: %v", err)
	}
	// an option that comes later replaces an earlier one
	joined := jsonv2.JoinOptions(jsonv2.AllowInvalidUTF8(true), jsonv2.AllowInvalidUTF8(false))
	if _, err := jsonv2.Marshal(in, joined); err == nil {
		t.Errorf("expected an error when the later option turns the allowance off")
	}
}

// equal reports whether a and b have the same JSON form.
func equal(a, b sample) bool {
	x, err := jsonv2.Marshal(a, options)
	if err != nil {
		return false
	}
	y, err := jsonv2.Marshal(b, options)
	if err != nil {
		return false
	}
	return string(x) == string(y)
}

// mustMarshal returns the JSON form of v.
func mustMarshal(t *testing.T, v any) string {
	t.Helper()
	b, err := jsonv2.Marshal(v, options)
	if err != nil {
		t.Fatalf("expected no error, got: %v", err)
	}
	return string(b)
}
